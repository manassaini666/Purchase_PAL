// use prisma-8

model Policy {
  id                String   @id @onCreate(uuid())
  maxSpendPerTx     Float    @default(63.00)
  manualApprovalAbove Float  @default(1.00)
  dailyBudget       Float    @default(150.00)
  monthlyBudget     Float    @default(300.00)
  allowedMerchants  String   @default("Merchant A, Merchant B")
  blockedCategories String   @default("Gift Cards, Crypto")
  allowedStartTime  String   @default("08:00")
  allowedEndTime    String   @default("22:00")
  updatedAt         DateTime @onCreate(now()) @onUpdate(now())
}

model Transaction {
  id        String   @id @onCreate(uuid())
  amount    Float
  merchant  String
  category  String
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())
}

model Dispute {
  id             String   @id @onCreate(cuid(2))
  transactionId  String
  merchantName   String
  freelancerName String
  amount         Float
  disputeReason  String
  status         String   @default("PENDING_ARBITRATION")
  aiVerdict      String?
  createdAt      DateTime @default(now())
}